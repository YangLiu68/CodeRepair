# CodeRepair configuration. Copy to .env and export the values you need, e.g.
#   set -a; source .env; set +a
# Never commit .env (it is git-ignored).

# Default backend for `coderepair propose`: oracle | scripted | anthropic | ollama
# (oracle and scripted are mocks; oracle replays the gold patch and is never a repair result)
CODEREPAIR_BACKEND=oracle

# Repositories may only be ingested from these roots (os.pathsep-separated).
# Default: the two benchmark suites (benchmarks/tasks and benchmarks/public).
# CODEREPAIR_ALLOWED_ROOTS=/path/to/benchmarks/tasks:/path/to/other/local/repos

# Benchmark suites (defaults shown).
# CODEREPAIR_TASKS_DIR=./benchmarks/tasks
# CODEREPAIR_PUBLIC_TASKS_DIR=./benchmarks/public

# Where run traces and proposed patches are written (default: ./runs, git-ignored).
# CODEREPAIR_RUNS_DIR=./runs

# --- Anthropic backend (optional: uv sync --extra anthropic) ---
# The SDK reads credentials itself: ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, or an `ant auth login` profile.
# ANTHROPIC_API_KEY=
CODEREPAIR_ANTHROPIC_MODEL=claude-opus-5-5
CODEREPAIR_ANTHROPIC_EFFORT=high
# Server-side refusal fallback (fallbacks="default"); set to 0 to disable.
CODEREPAIR_ANTHROPIC_FALLBACKS=1

# --- Ollama backend (local model, no data leaves the machine) ---
CODEREPAIR_OLLAMA_URL=http://127.0.0.1:11434
# The M5 benchmark used qwen2.5:3b (Qwen Research License; see LICENSE_NOTES.md).
CODEREPAIR_OLLAMA_MODEL=qwen2.5:7b

# Timeouts (seconds)
CODEREPAIR_LLM_TIMEOUT_S=300
CODEREPAIR_FIXTURE_TEST_TIMEOUT_S=120

# --- Sandbox for running tests (Milestone 2) ---
# auto = Docker if the daemon and image are available, else macOS Seatbelt; never the bare host.
CODEREPAIR_SANDBOX=auto
# Container image (only needs CPython; pytest comes from the runner bundle). Pin a digest for
# reproducible runs, e.g. python:3.12-slim@sha256:...
CODEREPAIR_SANDBOX_IMAGE=python:3.12-slim
CODEREPAIR_SANDBOX_TIMEOUT_S=60
CODEREPAIR_SANDBOX_MEMORY_MB=512
# Where the runner bundle is cached (default: ./.cache, git-ignored).
# CODEREPAIR_CACHE_DIR=./.cache
