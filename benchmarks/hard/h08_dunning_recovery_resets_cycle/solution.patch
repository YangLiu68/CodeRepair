diff --git a/billing/dunning.py b/billing/dunning.py
--- a/billing/dunning.py
+++ b/billing/dunning.py
@@ -74,7 +74,7 @@
         self.attempts.append(attempt)
         if succeeded:
             self.invoice.record_payment(self.invoice.amount_due)
-            self.subscription.reactivate(day)
+            self.subscription.recover(day)
             self.subscription.events.publish(
